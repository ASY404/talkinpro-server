# Talkin Pro — Environment Variables
# Copy this file to ".env" and fill in your values.
# On Render, set these as Environment Variables in the dashboard.

# ============================================================
# 1. SERVER
# ============================================================
PORT=3000
# The public URL of this Render service (Render sets this automatically after deploy).
# Example: https://talkinpro-server.onrender.com
PUBLIC_URL=

# ============================================================
# 2. APP VERSION CONTROL  (★ this controls updates)
# ============================================================
# The LATEST version of your modded app.
# When you release a new APK, bump this number.
# The app compares its own version against this.
APP_LATEST_VERSION=1.0.0
# The MINIMUM supported version. If a user's app is below this,
# they are FORCED to update. Set this to your first release version.
APP_MIN_VERSION=1.0.0
# Where users download the latest APK (your website or Firebase Storage URL).
# ★ When you push an update, upload the new APK here.
APP_DOWNLOAD_URL=https://talkin-pro-asy404.web.app/download
# Optional: your Discord invite (leave empty if you don't have one)
DISCORD_INVITE_URL=
# Changelog (array of strings — shown in the "What's new" section)
APP_CHANGELOG_1=Initial release of Talkin Pro
APP_CHANGELOG_2=All premium features unlocked
APP_CHANGELOG_3=Anti-mute, anti-kick, soundbox, voice effects

# ============================================================
# 3. CRYPTO / LICENSE KEYS  (★ generated by `npm run keygen`)
# ============================================================
# Run `npm run keygen` ONCE to generate these, then paste the output here.
# APP_SIGNING_SECRET is used to sign requests between app and server.
APP_SIGNING_SECRET=
# ENTITLEMENT_PUBLIC_KEY_HEX is the public half of an Ed25519 keypair.
# The private key (ENTITLEMENT_PRIVATE_KEY_HEX) stays on the server only.
ENTITLEMENT_PUBLIC_KEY_HEX=
ENTITLEMENT_PRIVATE_KEY_HEX=
# License key prefix (users enter keys like "pro_xxx" to activate)
KEY_PREFIX=pro_

# ============================================================
# 4. AGORA  (your Agora account — "Talkin Pro")
# ============================================================
AGORA_APP_ID=84c95fd2496e403ab14776f5c74a08ca
AGORA_APP_CERTIFICATE=efd9bd2ff054416caf3bcfcfcd1c3c2a

# ============================================================
# 5. TENCENT IM  (reusing existing SDK App ID)
# ============================================================
TENCENT_SDK_APP_ID=1721000587
# A secret key for encrypting/decrypting Tencent IM messages.
# Generate a random 32-byte hex string (64 hex chars).
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TENCENT_MSG_KEY=

# ============================================================
# 6. FIREBASE (Admin SDK — for push notifications)
# ============================================================
# Get this from Firebase Console → Project Settings → Service Accounts →
# "Generate new private key" → download JSON.
# Paste the ENTIRE JSON content here as a single line (or use FIREBASE_CREDENTIALS_PATH on Render).
FIREBASE_CREDENTIALS=
# Alternatively, on Render you can upload the JSON file and set the path:
# FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase-key.json

# ============================================================
# 7. FEATURE FLAGS  (which features are enabled for users)
# ============================================================
# Set to "true" to enable all features for everyone (no license key needed).
# Set to "false" to require a license key.
FREE_ENTITLEMENT=true

# ============================================================
# 8. ADMIN PANEL  (License Key Management — ASY404)
# ============================================================
# Admin username for the web dashboard at /admin
ADMIN_USERNAME=ASY404
# Admin password — SET THIS! Choose a strong password.
# Without this, the admin panel will be locked.
ADMIN_PASSWORD=

# ============================================================
# 9. DATA STORAGE  (License keys, devices, activity, messages)
# ============================================================
# Where the JSON database file is stored.
# Render free plan: ephemeral disk (data resets on restart).
# For permanent storage, use a Render Disk (paid) and set this to the disk mount path.
# Or use MongoDB Atlas (free) — see README for migration.
DATA_DIR=

